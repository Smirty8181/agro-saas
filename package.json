{
  "name": "diploom-agro-saas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "npm run dev --prefix server",
    "db:migrate": "npm run migrate --prefix server",
    "db:seed": "npm run seed --prefix server",
    "build": "tsc && vite build",
    "build:server": "npm run build --prefix server",
    "start:prod": "docker compose -f docker-compose.prod.yml up -d --build",
    "settlements": "node scripts/generate-settlements.mjs",
    "settlements:fetch": "curl.exe -L -o scripts/settlements-ru-source.csv https://raw.githubusercontent.com/NickyX3/russia_settlements/main/settlements.csv",
    "preview": "vite preview"
  },
  "dependencies": {
    "chart.js": "^4.3.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-vue-next": "^0.381.0",
    "pinia": "^3.0.4",
    "vue": "^3.4.3",
    "vue-router": "^4.3.3"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.5",
    "@types/leaflet.markercluster": "^1.5.6",
    "@vitejs/plugin-vue": "^4.3.3",
    "@vue/compiler-sfc": "^3.4.3",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^5.2.0"
  }
}
